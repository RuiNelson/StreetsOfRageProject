#!/usr/bin/env zsh
set -euo pipefail

# Round 8: the boss rush -- $56 -> $55 -> $30 -> $57 -> $58 -> Mr. X ($35)
#
# Opens the host in turbo and drives autoplay through the menus, the jump to
# round 8, and a continuous sweep of every non-boss enemy family. See
# ./scripts/go_to_boss for the shared flags and why the sweep is required.

exec "${0:A:h}/go_to_boss" 8 "$@"
