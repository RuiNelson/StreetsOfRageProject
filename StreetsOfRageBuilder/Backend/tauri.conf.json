{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streets of Rage Builder",
  "version": "0.1.0",
  "identifier": "com.ruinelson.streetsofragebuilder",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../Frontend"
    },
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../Frontend"
    },
    "frontendDist": "../Frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "Streets of Rage Builder",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
